<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS: runs `pipeline.py sync` every 15 minutes, also at login.
     Install: cp scheduling/com.reservationhub.sync.plist ~/Library/LaunchAgents/
              launchctl load ~/Library/LaunchAgents/com.reservationhub.sync.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.reservationhub.sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/germanmunoz/Desktop/reservation-hub/prototype/.venv/bin/python</string>
    <string>/Users/germanmunoz/Desktop/reservation-hub/prototype/pipeline.py</string>
    <string>sync</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/germanmunoz/Desktop/reservation-hub</string>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/germanmunoz/Desktop/reservation-hub/prototype/sync.log</string>
  <key>StandardErrorPath</key><string>/Users/germanmunoz/Desktop/reservation-hub/prototype/sync.log</string>
</dict>
</plist>
